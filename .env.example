# Copy to .env for local development. Paths are relative to the process working directory.
NOVA_GENERATOR_ENVIRONMENT=development
NOVA_GENERATOR_DATABASE_URL=sqlite:///./data/nova-generator.db
NOVA_GENERATOR_MEDIA_CACHE_ROOT=media_cache
NOVA_GENERATOR_PROJECT_ROOT=data/projects
NOVA_GENERATOR_WHISPER_MODEL=small
NOVA_GENERATOR_WHISPER_MODEL_ROOT=models/whisper
NOVA_GENERATOR_CHATTERBOX_MODEL_ROOT=models/chatterbox
NOVA_GENERATOR_FFMPEG_EXECUTABLE=ffmpeg
NOVA_GENERATOR_FFPROBE_EXECUTABLE=ffprobe
NOVA_GENERATOR_YTDLP_EXECUTABLE=yt-dlp
NOVA_GENERATOR_CLOUDFLARED_ENABLED=false
NOVA_GENERATOR_CLOUDFLARED_EXECUTABLE=cloudflared
