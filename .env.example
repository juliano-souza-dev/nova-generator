# Copy to .env for local development. Runtime/model paths default to the per-user
# global directory %LOCALAPPDATA%/NovaGenerator, outside this repository.
# Override NOVA_GENERATOR_HOME in the process environment to relocate it.
NOVA_GENERATOR_ENVIRONMENT=development
NOVA_GENERATOR_DATABASE_URL=sqlite:///./data/nova-generator.db
NOVA_GENERATOR_MEDIA_CACHE_ROOT=media_cache
NOVA_GENERATOR_PROJECT_ROOT=data/projects
NOVA_GENERATOR_WHISPER_MODEL=small
# Optional overrides; defaults are under %LOCALAPPDATA%/NovaGenerator/models.
# NOVA_GENERATOR_WHISPER_MODEL_ROOT=C:\NovaGeneratorData\models\whisper
# NOVA_GENERATOR_CHATTERBOX_MODEL_ROOT=C:\NovaGeneratorData\models\chatterbox
# Used by the one-click launcher; uncomment only for manual startup.
# NOVA_GENERATOR_TTS_PYTHON=C:\NovaGeneratorData\environments\chatterbox\Scripts\python.exe
NOVA_GENERATOR_FFMPEG_EXECUTABLE=ffmpeg
NOVA_GENERATOR_FFPROBE_EXECUTABLE=ffprobe
NOVA_GENERATOR_YTDLP_EXECUTABLE=yt-dlp
NOVA_GENERATOR_CLOUDFLARED_ENABLED=false
NOVA_GENERATOR_CLOUDFLARED_EXECUTABLE=cloudflared
