{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Generator",
  "version": "0.1.0",
  "identifier": "com.julianosouza.novagenerator",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1 --port 5173",
      "cwd": "../../frontend"
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../frontend"
    },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nova Generator",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:8000"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Estúdio de criação e edição multimídia com IA",
    "category": "Multimedia",
    "icon": []
  }
}
