{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersionhub.local/contracts/anki-ai/v1/input.schema.json",
  "title": "Anki preparation from the initial editorial AI package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "scene_id",
    "input_sha256",
    "cues",
    "instructions"
  ],
  "properties": {
    "contract": {
      "const": "nova-generator-anki-input/1.0"
    },
    "scene_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cue_id",
          "order",
          "original_en",
          "current_en",
          "current_pt",
          "speech_start_ms",
          "speech_end_ms"
        ],
        "properties": {
          "cue_id": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "original_en": {
            "type": "string"
          },
          "current_en": {
            "type": "string"
          },
          "current_pt": {
            "type": "string"
          },
          "speech_start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "speech_end_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_contract",
        "required_card_fields",
        "selection_policy",
        "integrity_policy"
      ],
      "properties": {
        "output_contract": {
          "const": "nova-generator-anki-proposal/1.0"
        },
        "required_card_fields": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "string"
          }
        },
        "selection_policy": {
          "type": "string",
          "minLength": 1
        },
        "integrity_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
