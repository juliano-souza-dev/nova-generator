{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersionhub.local/contracts/anki-ai/v2/output.schema.json",
  "title": "Didactic Anki cards derived from scene, with immutable source context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "scene_id",
    "input_sha256",
    "anki_cards"
  ],
  "properties": {
    "contract": {
      "const": "nova-generator-anki-proposal/2.0"
    },
    "scene_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "anki_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "cue_id",
          "source_context_en",
          "source_context_pt",
          "front_en",
          "back_pt",
          "uses_literal_scene_line",
          "card_type",
          "focus_text",
          "meaning",
          "marked_en",
          "marked_pt",
          "explanation_pt",
          "example_en",
          "example_pt",
          "tags"
        ],
        "properties": {
          "card_id": {
            "type": "string",
            "format": "uuid"
          },
          "cue_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_context_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "source_context_pt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "front_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "back_pt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uses_literal_scene_line": {
            "type": "boolean"
          },
          "card_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "focus_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "marked_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "marked_pt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "explanation_pt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "example_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "example_pt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "tags": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
