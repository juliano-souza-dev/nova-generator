{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-generator.local/contracts/generator-ihub/v1/hub-final.schema.json",
  "title": "Anki audio extension for a legacy hub_final.json",
  "type": "object",
  "required": ["ankiAudio"],
  "properties": {
    "ankiAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["youtube", "cues"],
      "properties": {
        "youtube": {"type": "object", "additionalProperties": false, "required": ["video_id"], "properties": {"video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"}}},
        "cues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/audioCue"}}
      }
    }
  },
  "$defs": {
    "audioCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue_order", "start_ms", "end_ms", "voice_id", "voice_name", "variant_index"],
      "properties": {
        "cue_order": {"type": "integer", "minimum": 1}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1},
        "voice_id": {"type": "string", "minLength": 1, "maxLength": 128}, "voice_name": {"type": "string", "minLength": 1, "maxLength": 128}, "variant_index": {"type": "integer", "minimum": 0}
      }
    }
  }
}
