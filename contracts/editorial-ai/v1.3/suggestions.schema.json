{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova-generator-editorial-suggestions/1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "input_sha256", "suggestions"],
  "properties": {
    "schema_version": {"const": "nova-generator-editorial-suggestions/1.3"},
    "scene_id": {"type": "string", "format": "uuid"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/suggestion"}
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_id", "order", "leading", "surface", "start_ms", "end_ms", "pt"],
      "properties": {
        "word_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "leading": {"type": "string"},
        "surface": {"type": "string", "minLength": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "pt": {"type": "string", "minLength": 1}
      }
    },
    "semantic_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_ids", "pt"],
      "properties": {
        "word_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "pt": {"type": "string", "minLength": 1}
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue_id", "order", "approved_en", "approved_pt", "notes", "word_translations", "semantic_units", "trailing"],
      "properties": {
        "cue_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "approved_en": {"type": "string", "minLength": 1},
        "approved_pt": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "word_translations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/word"}},
        "semantic_units": {"type": "array", "items": {"$ref": "#/$defs/semantic_unit"}},
        "trailing": {"type": "string"}
      }
    }
  }
}
