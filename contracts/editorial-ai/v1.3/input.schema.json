{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova-generator-editorial-input/1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "input_sha256", "cues"],
  "properties": {
    "schema_version": {"const": "nova-generator-editorial-input/1.3"},
    "scene_id": {"type": "string", "format": "uuid"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cue"}}
  },
  "$defs": {
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "surface", "current_pt", "semantic_group_id", "semantic_group_role", "leading", "start_ms", "end_ms", "original_start_ms", "original_end_ms", "confidence"],
      "properties": {
        "id": {"type": "string"},
        "order": {"type": "integer", "minimum": 1},
        "surface": {"type": "string", "minLength": 1},
        "current_pt": {"type": ["string", "null"]},
        "semantic_group_id": {"type": ["string", "null"]},
        "semantic_group_role": {"type": ["string", "null"]},
        "leading": {"type": "string"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "original_start_ms": {"type": "integer", "minimum": 0},
        "original_end_ms": {"type": "integer", "minimum": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "original_en", "current_en", "current_pt", "words", "speech_start_ms", "speech_end_ms", "subtitle_start_ms", "subtitle_end_ms", "trailing", "word_by_word_en", "requires_reconciliation"],
      "properties": {
        "id": {"type": "string"},
        "order": {"type": "integer", "minimum": 1},
        "original_en": {"type": "string", "minLength": 1},
        "current_en": {"type": "string"},
        "current_pt": {"type": "string"},
        "words": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/word"}},
        "speech_start_ms": {"type": "integer", "minimum": 0},
        "speech_end_ms": {"type": "integer", "minimum": 1},
        "subtitle_start_ms": {"type": "integer", "minimum": 0},
        "subtitle_end_ms": {"type": "integer", "minimum": 1},
        "trailing": {"type": "string"},
        "word_by_word_en": {"type": "string"},
        "requires_reconciliation": {"type": "boolean"}
      }
    }
  }
}
