{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-generator.local/contracts/unified-preparation/v1/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "project_id",
    "scene_id",
    "input_sha256",
    "editorial",
    "materials"
  ],
  "properties": {
    "contract": {
      "const": "nova-generator-unified-preparation-output/1.0"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "scene_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "editorial": {
      "type": "object",
      "required": [
        "schema_version",
        "scene_id",
        "input_sha256",
        "suggestions"
      ],
      "properties": {
        "schema_version": {
          "const": "nova-generator-editorial-suggestions/1.3"
        },
        "scene_id": {
          "type": "string"
        },
        "input_sha256": {
          "type": "string"
        },
        "suggestions": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "anki_cards"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "paragraphs",
              "exercises"
            ],
            "properties": {
              "id": {
                "enum": [
                  "learning_path",
                  "vocabulary",
                  "structures",
                  "guided_practice",
                  "activities",
                  "challenge",
                  "review"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exercises": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "prompt",
                    "answer"
                  ],
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "anki_cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "cue_id",
              "front_en",
              "back_pt",
              "explanation_pt",
              "card_type",
              "focus_text",
              "meaning",
              "marked_en",
              "marked_pt",
              "example_en",
              "example_pt"
            ]
          }
        }
      }
    }
  }
}
