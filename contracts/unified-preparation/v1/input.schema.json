{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-generator.local/contracts/unified-preparation/v1/input.schema.json",
  "title": "Pre-editorial single AI request, Shadowing prepared locally",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "output_contract",
    "project_id",
    "scene_id",
    "ingest_job_id",
    "input_sha256",
    "duration_ms",
    "editorial",
    "shadowing",
    "instructions"
  ],
  "properties": {
    "contract": {
      "const": "nova-generator-unified-preparation-input/1.0"
    },
    "output_contract": {
      "const": "nova-generator-unified-preparation-output/1.0"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "scene_id": {
      "type": "string",
      "format": "uuid"
    },
    "ingest_job_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "editorial": {
      "type": "object",
      "required": [
        "schema_version",
        "scene_id",
        "input_sha256",
        "cues"
      ],
      "properties": {
        "schema_version": {
          "const": "nova-generator-editorial-input/1.3"
        },
        "scene_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cues": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "shadowing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "editable_after_editorial",
        "ai_must_not_modify",
        "blocks"
      ],
      "properties": {
        "origin": {
          "const": "automatic"
        },
        "editable_after_editorial": {
          "const": true
        },
        "ai_must_not_modify": {
          "const": true
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "start_ms",
              "end_ms",
              "pause_duration_ms",
              "cue_ids",
              "en",
              "pt"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "start_ms": {
                "type": "integer"
              },
              "end_ms": {
                "type": "integer"
              },
              "pause_duration_ms": {
                "type": "integer",
                "minimum": 2000
              },
              "cue_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "en": {
                "type": "string"
              },
              "pt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "instructions": {
      "type": "object",
      "required": [
        "language",
        "response_contract",
        "editorial",
        "materials",
        "shadowing",
        "output_shape"
      ],
      "properties": {
        "response_contract": {
          "const": "nova-generator-unified-preparation-output/1.0"
        },
        "shadowing": {
          "type": "string"
        },
        "editorial": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "output_shape": {
          "type": "object"
        }
      }
    }
  }
}
