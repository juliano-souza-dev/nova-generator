{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersionhub.local/contracts/materials-ai/v1/input.schema.json",
  "title": "Nova Generator post-editorial material AI input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source_sha256",
    "source",
    "instructions"
  ],
  "properties": {
    "contract": {
      "const": "nova-generator-materials-input/1.0"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "project_id",
        "title",
        "content_type",
        "scenes"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scene_id",
              "order",
              "duration_ms",
              "cues",
              "shadowing"
            ],
            "properties": {
              "scene_id": {
                "type": "string",
                "format": "uuid"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 1
              },
              "cues": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "order",
                    "approved_en",
                    "approved_pt",
                    "speaker",
                    "speech_start_ms",
                    "speech_end_ms",
                    "words"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "order": {
                      "type": "integer"
                    },
                    "approved_en": {
                      "type": "string"
                    },
                    "approved_pt": {
                      "type": "string"
                    },
                    "speaker": {
                      "type": "string"
                    },
                    "speech_start_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "speech_end_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "words": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "surface",
                          "pt",
                          "semantic_group_id"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "surface": {
                            "type": "string"
                          },
                          "pt": {
                            "type": "string"
                          },
                          "semantic_group_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "shadowing": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "start_ms",
                    "end_ms",
                    "pause_duration_ms",
                    "cue_ids",
                    "en",
                    "pt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "start_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pause_duration_ms": {
                      "type": "integer",
                      "minimum": 2000
                    },
                    "cue_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "en": {
                      "type": "string"
                    },
                    "pt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "anki_prepared": {
          "type": "array",
          "description": "Optional prevalidated Anki mini-lessons from initial editorial export; unchanged literal approved cue identity.",
          "items": {
            "type": "object",
            "description": "A card according to Anki proposal; full card fields validated at import."
          }
        },
        "anki_prepared_needs_review": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of Anki draft cards invalidated by later editorial changes."
        }
      }
    },
    "instructions": {
      "type": "object",
      "required": [
        "output_contract",
        "required_section_ids_in_order",
        "language",
        "policy"
      ],
      "properties": {
        "output_contract": {
          "const": "nova-generator-materials-output/1.0"
        },
        "required_section_ids_in_order": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      }
    }
  }
}
