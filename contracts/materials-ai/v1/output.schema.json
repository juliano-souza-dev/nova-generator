{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersionhub.local/contracts/materials-ai/v1/output.schema.json",
  "title": "Nova Generator external pedagogical material result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "project_id",
    "source_sha256",
    "title",
    "sections",
    "anki_cards"
  ],
  "properties": {
    "contract": {
      "const": "nova-generator-materials-output/1.0"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "sections": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "paragraphs"
        ],
        "properties": {
          "id": {
            "enum": [
              "learning_path",
              "vocabulary",
              "structures",
              "guided_practice",
              "activities",
              "challenge",
              "review"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exercises": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "prompt",
                "answer"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000
                },
                "answer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000
                }
              }
            }
          }
        }
      }
    },
    "anki_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cue_id",
          "front_en",
          "back_pt",
          "explanation_pt"
        ],
        "properties": {
          "cue_id": {
            "type": "string",
            "format": "uuid"
          },
          "front_en": {
            "type": "string",
            "minLength": 1
          },
          "back_pt": {
            "type": "string",
            "minLength": 1
          },
          "explanation_pt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "tags": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
