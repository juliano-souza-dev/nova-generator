{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-generator.local/contracts/editorial-cues/1.0/schema.json",
  "title": "Nova Generator Editorial Cue Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "project_id", "timeline", "cues"],
  "properties": {
    "schema": {"const": "nova-generator/editorial-cues"},
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "format": "uuid"},
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "duration_ms"],
      "properties": {"origin": {"const": "scene_local_ms"}, "duration_ms": {"type": "integer", "minimum": 1}}
    },
    "cues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cue"}}
  },
  "$defs": {
    "literal": {"type": "object", "additionalProperties": false, "required": ["value", "utf8_sha256"], "properties": {"value": {"type": "string", "minLength": 1}, "utf8_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["start_ms", "end_ms"], "properties": {"start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}}},
    "token": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "surface", "char_start", "char_end", "kind", "timing", "gloss_pt", "review_status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "order": {"type": "integer", "minimum": 1}, "surface": {"type": "string", "minLength": 1},
        "char_start": {"type": "integer", "minimum": 0}, "char_end": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["word", "punctuation", "whitespace"]}, "timing": {"anyOf": [{"$ref": "#/$defs/timing"}, {"type": "null"}]},
        "gloss_pt": {"type": ["string", "null"]}, "semantic_group_id": {"type": ["string", "null"], "format": "uuid"},
        "review_status": {"enum": ["pending", "approved"]}
      }
    },
    "cue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "speech_timing", "subtitle_timing", "speaker", "original_en", "approved_en", "approved_pt", "tokens", "revision"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "order": {"type": "integer", "minimum": 1},
        "speech_timing": {"$ref": "#/$defs/timing"}, "subtitle_timing": {"$ref": "#/$defs/timing"}, "speaker": {"type": "string"},
        "original_en": {"$ref": "#/$defs/literal"}, "approved_en": {"$ref": "#/$defs/literal"}, "approved_pt": {"$ref": "#/$defs/literal"},
        "tokens": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "revision": {"type": "integer", "minimum": 1}
      }
    }
  }
}
